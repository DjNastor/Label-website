# Public production URL shown inside the Label Intelligence workspace.
# This does not create the deployment alias by itself; add the matching
# Vercel/domain alias in the hosting provider.
VITE_PUBLIC_APP_URL=https://lukulu-recordings.vercel.app

# Spotify catalogue/profile import.
# For local FastAPI stub: http://localhost:8000
# For production: the deployed API URL that owns OAuth and token exchange.
VITE_SPOTIFY_API_URL=
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=https://lukulu-recordings.vercel.app/spotify/callback

# Optional backend services for live social imports and OpenAI-powered news.
# For the included local FastAPI stub, both can be http://localhost:8000.
VITE_SOCIAL_FEEDS_API_URL=
VITE_AI_INTELLIGENCE_API_URL=
